{
  "name": "snipeit-mcp",
  "version": "0.1.0",
  "description": "MCP server for Snipe-IT asset management: full CRUD, checkout/checkin, audit and restore over the Snipe-IT REST API. Built on MCP TypeScript SDK v2.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "bin": {
    "snipeit-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --test test/unit.test.mjs test/config.test.mjs test/tools.test.mjs test/harness.test.mjs",
    "test:integration": "npm run build && node --test test/integration.test.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "snipe-it",
    "snipeit",
    "asset-management",
    "ai-agent",
    "openclaw",
    "claude"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l0cky12/snipeit-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/l0cky12/snipeit-mcp/issues"
  },
  "homepage": "https://github.com/l0cky12/snipeit-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
